{
  "name": "@arabold/docs-mcp-server",
  "version": "3.3.0",
  "description": "MCP server for fetching and searching documentation",
  "type": "module",
  "bin": {
    "docs-mcp-server": "dist/index.js"
  },
  "license": "MIT",
  "author": "grounded.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arabold/docs-mcp-server.git"
  },
  "files": [
    "dist",
    "public",
    "db",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "prepare": "husky || true",
    "build": "npm run build:web && vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "start": "node --enable-source-maps dist/index.js",
    "cli": "node --enable-source-maps dist/index.js",
    "server": "node --enable-source-maps dist/index.ts",
    "web": "node --enable-source-maps dist/index.ts web",
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "vite-node --watch src/index.ts",
    "dev:web": "npm run build:web -- --watch",
    "test": "vitest run --exclude test/docker-e2e.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude test/docker-e2e.test.ts",
    "test:unit": "vitest run src",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest run --exclude test/docker-e2e.test.ts test",
    "test:docker": "vitest run test/docker-e2e.test.ts",
    "evaluate:search": "vite-node tests/search-eval/run.ts --measure",
    "evaluate:search:baseline": "vite-node tests/search-eval/run.ts --baseline",
    "evaluate:search:preflight": "vite-node tests/search-eval/cli/preflight.ts",
    "evaluate:accuracy": "vitest run --config vite.config.accuracy.ts",
    "evaluate:accuracy:baseline": "vitest run --config vite.config.accuracy.ts --mode baseline",
    "test:live": "vitest run --config vite.config.live.ts test/html-pipeline-live-e2e.test.ts test/github-scrape-live-e2e.test.ts",
    "test:auth:clerk": "npm run build && vite-node test/clerk-auth-live.ts --",
    "release:notes": "node scripts/release/ai-release-notes.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "typecheck": "npx tsc --noEmit",
    "typecheck:build": "npx tsc --noEmit --project tsconfig.build.json",
    "format": "biome format . --write",
    "postinstall": "echo 'Skipping Playwright browser install. See README.md for details.'"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@langchain/aws": "^1.5.0",
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/google-vertexai": "^2.3.4",
    "@langchain/openai": "^1.7.0",
    "@langchain/textsplitters": "^1.0.2",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/server-legacy": "^2.4.0",
    "@tanstack/react-query": "^5.104.5",
    "@toon-format/toon": "^2.3.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@types/yargs": "^17.0.35",
    "@xberg-io/xberg": "~1.0.14",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "defuddle": "^0.19.5",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "env-paths": "^4.0.0",
    "fastify": "^5.12.7",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "header-generator": "^2.1.89",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.13",
    "jsdom": "^29.1.1",
    "langchain": "^1.5.19",
    "linkedom": "^0.18.14",
    "mime": "^4.1.1",
    "minimatch": "^10.2.6",
    "playwright": "^1.64.1",
    "posthog-node": "^5.57.1",
    "psl": "^1.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "semver": "^7.8.5",
    "sqlite-vec": "^0.1.9",
    "superjson": "^2.2.6",
    "tar": "^7.5.22",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "uuid": "^14.0.3",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/lint-staged": "~13.3.0",
    "@types/node": "^26.6.5",
    "@types/node-fetch": "^2.6.13",
    "@types/psl": "~1.1.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/tar": "^6.1.13",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^8.0.0",
    "domhandler": "^6.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "memfs": "^4.80.0",
    "msw": "^2.15.0",
    "npm-run-all": "^4.1.5",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md}": [
      "biome check --write --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
