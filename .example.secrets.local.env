# Copy these variable names to .secrets.local.env and replace the placeholders.
# Never put real credentials or private server details in this example file.

# Remote Grounded Docs access
REMOTE_DOCS_WEB_USERNAME=grounded-admin
REMOTE_DOCS_WEB_PASSWORD=
REMOTE_DOCS_MCP_READ_BEARER_TOKEN=
REMOTE_DOCS_MCP_ADMIN_BEARER_TOKEN=

REMOTE_SERVER_HOST=server.example.com
REMOTE_SERVER_PORT=22
REMOTE_SERVER_USER=deploy
REMOTE_SERVER_SSH_PASSWORD=
REMOTE_SERVER_SSH_KEY_PATH=/absolute/path/to/private/key
REMOTE_SERVER_PROJECT_DIR=/opt/docs-mcp-server

# Polza.ai embeddings
POLZA_API_KEY=
POLZA_API_BASE=https://polza.ai/api/v1
DEEPINFRA_API_KEY=

# Voyage AI reranker
VOYAGE_API_KEY=
