{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "service", "dataPersistence", "configPersistence", "ingress", "route"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$" }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "command": { "type": "array", "items": { "type": "string" } },
    "args": { "type": "array", "items": { "type": "string" } },
    "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "openshift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "service": { "$ref": "#/definitions/service" },
    "dataPersistence": { "$ref": "#/definitions/persistence" },
    "configPersistence": { "$ref": "#/definitions/persistence" },
    "tmpVolume": { "type": "object" },
    "ingress": { "$ref": "#/definitions/ingress" },
    "route": { "$ref": "#/definitions/route" },
    "resources": { "type": "object" },
    "startupProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "envFrom": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "extraResources": { "type": "array", "items": { "type": "object" } },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "serviceAccount": {
      "type": "object",
      "required": ["create", "automountServiceAccountToken", "annotations", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "automountServiceAccountToken": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "annotations"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array", "items": { "type": "object" } },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    },
    "route": {
      "type": "object",
      "required": ["enabled", "host", "annotations", "wildcardPolicy", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "annotations": { "type": "object" },
        "wildcardPolicy": { "enum": ["None", "Subdomain"] },
        "tls": {
          "type": "object",
          "required": ["enabled", "termination", "insecureEdgeTerminationPolicy"],
          "properties": {
            "enabled": { "type": "boolean" },
            "termination": { "enum": ["edge"] },
            "insecureEdgeTerminationPolicy": { "enum": ["Allow", "Disable", "Redirect"] }
          }
        }
      }
    }
  }
}
